// This Pine Script code is subject to the terms of the Mozilla Public License 2.0
//@version=5
strategy("Supertrend Long-Only Overlay — BTC/ETH", shorttitle="ST-Overlay",
     overlay=true, initial_capital=10000,
     commission_type=strategy.commission.percent, commission_value=0.1,
     slippage=2, pyramiding=0, calc_on_every_tick=false,
     process_orders_on_close=true)

// =========================================================================
// Long-only trend overlay, validated specifically on BTC and ETH (not a
// general-purpose multi-asset system -- tested and underperformed on
// XRP/BNB, see strategies/README.md).
//
// Mechanism: fully invested (long) while Supertrend direction is bullish;
// flat / in cash (NOT short) while bearish. No fixed stop-loss or
// take-profit -- the point is to capture buy-and-hold-like upside during
// uptrends while sidestepping major drawdowns/crashes during downtrends,
// rather than trying to out-trade the market with tight stops that cap
// winners (which is what every earlier iteration of this research did,
// and which consistently underperformed simple buy-and-hold).
//
// Out-of-sample backtest results (train/test split, vs raw buy-and-hold
// on the same held-out period):
//   BTC 1D: overlay +48.8% (max DD 41.5%) vs buy-hold +48.0% (DD 53.0%)
//   ETH 1D: overlay  +8.3% (max DD 47.0%) vs buy-hold -23.7% (DD 67.5%)
//   BTC 4h: overlay  +7.4% (max DD 28.1%) vs buy-hold -23.3% (DD 53.4%)
//   ETH 4h: overlay +52.8% (max DD 46.6%) vs buy-hold  +4.2% (DD 68.0%)
//
// Honest caveats:
//   - Drawdowns are still large in ABSOLUTE terms (28-47%) because this
//     is full (or Position Size %) exposure while in a position, not a
//     small tactical bet. It beats buy-and-hold's risk/return on the
//     same asset, but it is not a "low drawdown" system in isolation.
//   - Only validated on BTC and ETH. Do not assume it generalizes to
//     other assets without the same train/test validation.
//   - Past out-of-sample performance is not a guarantee of future
//     results -- re-validate periodically as new data comes in.
// =========================================================================

atrLen = input.int(21, "ATR Length", minval=1, group="Supertrend")
mult = input.float(4.0, "ATR Multiplier", minval=0.1, step=0.1, group="Supertrend")
allocPct = input.float(100.0, "Position Size (% of equity)", minval=1, maxval=100, group="Position Sizing")

// === Backtest Window ===
startDate = input.time(timestamp("2017-01-01T00:00:00"), "Backtest Start", group="Backtest Window")
endDate   = input.time(timestamp("2069-01-01T00:00:00"), "Backtest End", group="Backtest Window")
inWindow  = time >= startDate and time <= endDate

[supertrendLine, direction] = ta.supertrend(mult, atrLen)
// Pine's built-in ta.supertrend direction convention: -1 = uptrend (price
// above the line), 1 = downtrend (price below the line).
isBullish = direction < 0

plot(supertrendLine, "Supertrend", color = isBullish ? color.new(color.teal, 0) : color.new(color.red, 0), linewidth = 2)
bgcolor(isBullish ? color.new(color.teal, 92) : color.new(color.red, 92), title = "Trend state")

longCondition = isBullish and not isBullish[1] and inWindow
exitCondition = (not isBullish) and isBullish[1]

qty = (strategy.equity * allocPct / 100) / close

if longCondition
    strategy.entry("Long", strategy.long, qty = qty)

if exitCondition or (not inWindow)
    strategy.close("Long")

alertcondition(longCondition, title = "Enter Long", message = "ST-Overlay: ENTER LONG on {{ticker}} at {{close}}")
alertcondition(exitCondition, title = "Exit to Cash", message = "ST-Overlay: EXIT TO CASH on {{ticker}} at {{close}}")
